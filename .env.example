# ==============================================================================
# RecoverOS — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND / RENDER ENVIRONMENT VARIABLES (server/.env or Render Dashboard)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development                       # 'development' or 'production'
MONGO_URI=mongodb://127.0.0.1:27017/recoveros # In Prod: MongoDB Atlas connection string
GROK_API_KEY=your_xai_grok_api_key_here     # Optional: Leave blank to use deterministic FallbackEngine
GROK_MODEL=grok-2-latest                     # Default: grok-2-latest
CLIENT_URL=http://localhost:5173            # In Prod: Vercel domain(s), e.g. https://recoveros.vercel.app
AI_TIMEOUT_MS=3500
AI_MODE=deterministic                      # 'live' or 'deterministic'
SIMULATION_SEED=RECOVEROS_BUILDATHON_2026

# Backend Authentication & Security
# - In development: Leave blank to auto-bypass auth for frictionless local testing.
# - In production: Optional. If set, requires matching x-api-key header on mutating requests.
API_KEY=

# ------------------------------------------------------------------------------
# 2. FRONTEND / VERCEL ENVIRONMENT VARIABLES (client/.env or Vercel Dashboard)
# ------------------------------------------------------------------------------
# In Local Dev: http://localhost:5000/api (or leave blank to use Vite /api proxy)
# In Production: Set to your live Render backend URL, e.g. https://recoveros-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: Set to match server API_KEY if backend authentication is enabled
VITE_API_KEY=
